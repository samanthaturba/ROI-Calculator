# ============================================================
# ROI Calculator — Environment Variables
# ============================================================
# Copy to .env.local for local dev. Set in Vercel for prod.
# ============================================================

# Anthropic Claude API key — powers the "Generate AI Industry Profile" feature.
# Get from: https://console.anthropic.com/settings/api-keys
# If unset, the AI Generate button will return a 500 error.
ANTHROPIC_API_KEY=

# Password to unlock the AI Generate feature in the UI.
# Defaults to "cogent.123" if unset. Change this for production to avoid abuse.
GENERATE_PASSWORD=cogent.123
